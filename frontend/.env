# All public website forms are delivered by the Express server via SMTP.
FORM_RECIPIENT_EMAIL=Info@buttrdme.com

# SMTP settings are required for email delivery.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# SMTP_FROM_EMAIL=website@buttrdme.com
# SMTP_FROM_NAME=Buttrd Website
