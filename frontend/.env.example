# All public website forms are delivered by the Express server via SMTP.
# Set this to the single inbox that should receive contact, feedback, and catering forms.
FORM_RECIPIENT_EMAIL=Info@buttrdme.com

# SMTP settings are required for email delivery.
# Use your own mail server or mailbox provider's SMTP credentials.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM_EMAIL=website@buttrdme.com
SMTP_FROM_NAME=Buttrd Website

# Admin password for /admin (required in production)
ADMIN_PASSWORD=buttrd-admin-change-me

# Optional - server port (default 5173)
# PORT=5173

# Required in production if admin-edited content/uploads must survive redeploys.
# Railway example: mount a volume at /data and set:
# PERSISTENT_DATA_DIR=/data
